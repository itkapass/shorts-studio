# ─────────────────────────────────────────────────────────────────
# .env — Environment Variables
#
# INSTRUCTIONS:
#   1. Copy this file to .env and fill in your actual API keys there.
#   2. Never commit .env (it's in .gitignore) — and just as important,
#      never zip, screenshot, or paste it anywhere either, including into
#      an AI chat. A previous version of this project got a real
#      Supabase service_role key exposed exactly that way. If a secret is
#      ever exposed like that, rotate it — don't just remove the file.
#   3. Add these same values as GitHub Actions Secrets (Settings → Secrets)
#      for the scheduled pipeline, and as Vercel env vars for the Admin
#      Panel (only the VITE_ prefixed ones — see admin-panel/.env.example).
# ─────────────────────────────────────────────────────────────────

# ── AI Script Generation ──────────────────────────────────────────
# Get from: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Gemini model names retire on a ~4-6 month cycle (this project
# has already hit that once — the original hardcoded gemini-1.5-flash is
# very likely dead by the time you read this). Leave unset to use the
# code's current default, or override here without touching code. Check
# https://ai.google.dev/gemini-api/docs/models for what's current.
# GEMINI_MODEL=gemini-3.5-flash

# ── Visual B-Roll Assets (stock_footage render style only) ────────
# Get from: https://www.pexels.com/api/ → Your API Key
PEXELS_API_KEY=your_pexels_api_key_here

# ── Database & Storage ────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── YouTube Publishing ─────────────────────────────────────────────
# Run `python engine/publisher.py --setup` once locally (needs a real
# browser) — it opens Google's consent screen, then prints these three
# values for you to paste in here and as GitHub secrets. See
# docs/04_AUTONOMOUS_YOUTUBE_PUBLISHING.md, including the note about
# refresh tokens expiring after 7 days if your OAuth consent screen is
# still in "Testing" status.
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# ── Pipeline Settings ─────────────────────────────────────────────
OUTPUT_DIR=output
ASSETS_DIR=assets
# PUBLISH_PER_RUN=1   # optional override — normally set via the Admin Panel's Settings page instead


# ─────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE R2 STORAGE  (optional — see docs/06)
# ─────────────────────────────────────────────────────────────────────────────
# 10 GB free with no egress fees, vs Supabase Storage's 1 GB.
# Leave ALL FOUR blank and the app automatically uses Supabase Storage instead.
# Setting only some of them does NOT half-work — it falls back to Supabase.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The https://pub-....r2.dev URL from the bucket's public-access settings.
# No trailing slash.
R2_PUBLIC_BASE=
STORAGE_BUCKET=shorts-videos

# ─────────────────────────────────────────────────────────────────────────────
# ALERTS  (optional but strongly recommended — see docs/08)
# ─────────────────────────────────────────────────────────────────────────────
# Every failure in this pipeline is SILENT. Without alerting you find out weeks
# later. Telegram takes 5 minutes and is free forever.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts. With Gmail use an App Password, not your real password.
# Port 587 = STARTTLS, port 465 = implicit TLS. Mixing them up is the most
# common reason SMTP silently fails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ─────────────────────────────────────────────────────────────────────────────
# PER-CHANNEL YOUTUBE SECRETS  (only if running more than one channel)
# ─────────────────────────────────────────────────────────────────────────────
# A channel with env_suffix "SCIENCE" reads these instead of the unsuffixed
# names. Give each channel its OWN Google Cloud project — the 10,000-unit daily
# quota is per project, not per channel. See docs/07 section 5.
# YOUTUBE_CLIENT_ID_SCIENCE=
# YOUTUBE_CLIENT_SECRET_SCIENCE=
# YOUTUBE_REFRESH_TOKEN_SCIENCE=

# ─────────────────────────────────────────────────────────────────────────────
# OFFLINE TTS FALLBACK  (optional — see docs/03)
# ─────────────────────────────────────────────────────────────────────────────
# edge-tts is free and good but unofficial; it can break when Microsoft changes
# something. Piper is a fully offline neural TTS that cannot be broken by a
# third party. Download a voice model and point this at the .onnx file.
PIPER_MODEL_PATH=

# GEMINI_MODEL is now OPTIONAL. Left blank, the app asks Google which models
# actually exist right now and picks the best free-tier one. Set it only to pin
# a specific model.

# How much Gemini varies its wording (0.2 = safe/repetitive, 0.9 = default,
# 1.4 = highly varied but riskier). Also adjustable live in Settings.
GEMINI_TEMPERATURE=0.9
